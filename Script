local TOGGLE_KEY = Enum.KeyCode.M -- open / close menu
local SPEED_RANGE = { 0, 200 }
local JUMP_RANGE = { 0, 300 }
------------------------------------------

if STUDIO_ONLY and not RunService:IsStudio() then return end

local localPlayer = Players.LocalPlayer

-------------------- State --------------------
local espEnabled = false
local showNames = true
local fillTransparency = 0.6
local colorIndex = 1
local walkSpeed = 16
local jumpPower = 50
local infJump = false
local speedEnabled = false
local jumpEnabled = false

local COLORS = {
	Color3.fromRGB(255, 80, 80),
	Color3.fromRGB(70, 210, 130),
	Color3.fromRGB(95, 130, 255),
	Color3.fromRGB(255, 205, 70),
	Color3.fromRGB(255, 255, 255),
}

-------------------- Highlight logic --------------------
local effects = {}

local function clearPlayer(plr)
	local e = effects[plr]
	if e then
		if e.highlight then e.highlight:Destroy() end
		if e.billboard then e.billboard:Destroy() end
		effects[plr] = nil
	end
end

local function applyPlayer(plr)
	clearPlayer(plr)
	if not espEnabled or plr == localPlayer then return end
	local char = plr.Character
	if not char then return end

	local color = COLORS[colorIndex]
	local h = Instance.new("Highlight")
	h.FillColor = color
	h.OutlineColor = color
	h.FillTransparency = fillTransparency
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.Adornee = char
	h.Parent = char

	local bb
	local head = char:FindFirstChild("Head")
	if showNames and head then
		bb = Instance.new("BillboardGui")
		bb.Size = UDim2.fromOffset(120, 24)
		bb.StudsOffset = Vector3.new(0, 2.5, 0)
		bb.AlwaysOnTop = true
		bb.Adornee = head
		bb.Parent = head
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Text = plr.DisplayName
		label.TextColor3 = color
		label.TextStrokeTransparency = 0.4
		label.Font = Enum.Font.GothamBold
		label.TextSize = 14
		label.Parent = bb
	end
	effects[plr] = { highlight = h, billboard = bb }
end

local function refreshAll()
	for _, plr in ipairs(Players:GetPlayers()) do applyPlayer(plr) end
end

local function track(plr)
	plr.CharacterAdded:Connect(function()
		task.wait(0.2)
		applyPlayer(plr)
	end)
	applyPlayer(plr)
end
for _, plr in ipairs(Players:GetPlayers()) do track(plr) end
Players.PlayerAdded:Connect(track)
Players.PlayerRemoving:Connect(clearPlayer)

-------------------- Movement logic --------------------
local function getHumanoid()
	local char = localPlayer.Character
	return char and char:FindFirstChildOfClass("Humanoid")
end

local function applyMovement()
	local hum = getHumanoid()
	if not hum then return end
	if speedEnabled then hum.WalkSpeed = walkSpeed end
	if jumpEnabled then
		hum.UseJumpPower = true
		hum.JumpPower = jumpPower
	end
end

localPlayer.CharacterAdded:Connect(function()
	task.wait(0.2)
	applyMovement()
end)

UserInputService.JumpRequest:Connect(function()
	if infJump then
		local hum = getHumanoid()
		if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
	end
end)

-------------------- UI helpers --------------------
local BG = Color3.fromRGB(20, 20, 27)
local PANEL = Color3.fromRGB(32, 32, 42)
local PANEL_2 = Color3.fromRGB(44, 44, 58)
local ACCENT = Color3.fromRGB(95, 130, 255)
local TEXT = Color3.fromRGB(240, 240, 248)
local MUTED = Color3.fromRGB(145, 145, 165)

local function make(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end

local function corner(o, r)
	return make("UICorner", { CornerRadius = UDim.new(0, r or 8) }, o)
end

local function tween(o, t, props)
	TweenService:Create(o, TweenInfo.new(t, Enum.EasingStyle.Quad), props):Play()
end

