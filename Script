-------------------- Components --------------------
local function toggle(parent, y, text, initial, callback)
	make("TextLabel", {
		Size = UDim2.new(1, -80, 0, 28),
		Position = UDim2.fromOffset(12, y),
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = TEXT,
		Font = Enum.Font.Gotham,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, parent)

	local trackBtn = make("TextButton", {
		Size = UDim2.fromOffset(44, 22),
		Position = UDim2.new(1, -56, 0, y + 3),
		BackgroundColor3 = initial and ACCENT or PANEL_2,
		Text = "",
		AutoButtonColor = false,
	}, parent)
	corner(trackBtn, 11)
	local knob = make("Frame", {
		Size = UDim2.fromOffset(16, 16),
		Position = initial and UDim2.fromOffset(25, 3) or UDim2.fromOffset(3, 3),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
	}, trackBtn)
	corner(knob, 8)

	local state = initial
	trackBtn.MouseButton1Click:Connect(function()
		state = not state
		tween(trackBtn, 0.15, { BackgroundColor3 = state and ACCENT or PANEL_2 })
		tween(knob, 0.15, { Position = state and UDim2.fromOffset(25, 3) or UDim2.fromOffset(3, 3) })
		callback(state)
	end)
end

local function slider(parent, y, text, min, max, initial, callback)
	make("TextLabel", {
		Size = UDim2.new(1, -90, 0, 20),
		Position = UDim2.fromOffset(12, y),
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = TEXT,
		Font = Enum.Font.Gotham,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, parent)

	local valueLabel = make("TextLabel", {
		Size = UDim2.fromOffset(60, 20),
		Position = UDim2.new(1, -72, 0, y),
		BackgroundTransparency = 1,
		Text = tostring(initial),
		TextColor3 = MUTED,
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Right,
	}, parent)

	local bar = make("TextButton", {
		Size = UDim2.new(1, -24, 0, 8),
		Position = UDim2.fromOffset(12, y + 30),
		BackgroundColor3 = PANEL_2,
		Text = "",
		AutoButtonColor = false,
	}, parent)
	corner(bar, 4)

	local fill = make("Frame", {
		Size = UDim2.fromScale((initial - min) / (max - min), 1),
		BackgroundColor3 = ACCENT,
		BorderSizePixel = 0,
	}, bar)
	corner(fill, 4)

	local knob = make("Frame", {
		Size = UDim2.fromOffset(16, 16),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new((initial - min) / (max - min), 0, 0.5, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
	}, bar)
	corner(knob, 8)

	local dragging = false
	local function setFromX(x)
		local alpha = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		local value = math.floor(min + (max - min) * alpha + 0.5)
		fill.Size = UDim2.fromScale(alpha, 1)
		knob.Position = UDim2.new(alpha, 0, 0.5, 0)
		valueLabel.Text = tostring(value)
		callback(value)
	end

	bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			main.Draggable = false
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
			main.Draggable = true
		end
	end)
end

